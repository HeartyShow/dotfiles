{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin"
  },
  "keybinds": {
    "leader": "ctrl+o",
    "input.submit": "return",
    "input.newline": "shift+return",
    "session.aside": "<leader>k"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "fullscreen": true
  },
  "prompt": {
    "paste": "compact"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "markdown": "rendered",
    "verbosity": "medium",
    "image_preview": false,
    "tps": true,
    "new_location": "launch",
    "permissions": "prompt",
    "grouping": "auto"
  },
  "animations": true,
  "tabs": {
    "mode": "off",
    "layout": "vertical",
    "scope": "cwd",
    "indicators": "status"
  },
  "terminal": {
    "title": true
  },
  "plugins": [
    "opencode-vim@latest",
    "opencode-mini-session@latest",
    "@streetturtle/opencode-recap"
  ]
}
