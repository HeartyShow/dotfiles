{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "agent": {
    "plan": {
      "prompt": "{file:./prompts/plan-style.md}"
    }
  },
  "instructions": [
    "./instructions/analysis-style.md"
  ],
  "share": "disabled",
  "autoupdate": true,
  "plugin": [
    "@tarquinen/opencode-dcp"
  ],
  "lsp": true,
  "compaction": {
    "auto": true
  },
  "experimental": {
    "artifacts": true
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  }
}
