{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "instructions": [
    "./instructions/analysis-style.md"
  ],
  "share": "disabled",
  "autoupdate": true,
  "plugin": [
    "./plugins/bell.mjs",
    "@tarquinen/opencode-dcp",
    "opencode-mermaid-renderer"
  ],
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  }
}
